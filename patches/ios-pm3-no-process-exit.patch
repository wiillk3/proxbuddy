@@ -68,7 +87,14 @@
     if (quiet) {
         g_printAndLog &= ~PRINTANDLOG_PRINT;
     }
+    if (setjmp(pm3_ios_exit_jmp)) {
+        pm3_ios_exit_armed = 0;
+        g_printAndLog = prev_printAndLog;
+        return PM3_EFATAL;
+    }
+    pm3_ios_exit_armed = 1;
     int ret = CommandReceived(cmd);
+    pm3_ios_exit_armed = 0;
     g_printAndLog = prev_printAndLog;
     return ret;
 }
